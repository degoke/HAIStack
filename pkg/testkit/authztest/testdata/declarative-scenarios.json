      "resource": {
        "resourceType": "Appointment",
        "id": "a1",
        "status": "booked",
        "participant": [{ "actor": { "reference": "Patient/pat-1" }, "status": "accepted" }]
      },
      "expectAllow": false
    },
    {
      "id": "smart_scope_and_policy_allow_observation",
      "doc": "SMART patient/*.read with Observation-only policy allows Observation read.",
      "principal": "clinician",
      "policy": "narrow-observation",
      "scopes": "patient/*.read",
      "launchPatient": "pat-1",
      "action": "read",
      "resourceType": "Observation",
      "resourceId": "obs-1",
      "resource": {
        "resourceType": "Observation",
        "id": "obs-1",
        "status": "final",
        "subject": { "reference": "Patient/pat-1" },
        "code": { "text": "toy" }
      },
      "expectAllow": true
    },
    {
      "id": "smart_scope_denies_policy_would_allow",
