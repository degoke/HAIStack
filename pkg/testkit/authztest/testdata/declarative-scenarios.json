      "expectAllow": false
    },
    {
      "id": "cross_tenant_denied",
      "doc": "Principal bound to tenant-a cannot act in tenant-b.",
      "principal": "clinician",
      "policy": "base",
      "tenant": "tenant-b",
      "action": "read",
      "resourceType": "Appointment",
      "resourceId": "a1",
      "expectAllow": false
    },
    {
      "id": "purpose_of_use_mismatch",
      "doc": "Treat-only rule does not match ETREAT purpose of use.",
      "principal": "clinician",
      "policy": "treat-only",
      "purposeOfUse": "ETREAT",
      "action": "read",
      "resourceType": "Observation",
      "resourceId": "obs-1",
      "expectAllow": false
    },
    {
      "id": "consent_permit_observation",
      "doc": "Active Consent permit on Observation does not block an otherwise allowed read.",
      "principal": "clinician",
      "policy": "narrow-observation",
      "scopes": "patient/*.read",
      "launchPatient": "pat-1",
      "action": "read",
      "resourceType": "Observation",
      "resourceId": "obs-1",
      "resource": {
        "resourceType": "Observation",
        "id": "obs-1",
        "status": "final",
        "subject": { "reference": "Patient/pat-1" },
        "code": { "text": "toy" }
      },
      "consent": {
        "status": "active",
        "patientId": "pat-1",
        "provisionType": "permit",
        "resourceTypes": ["Observation"],
        "actions": ["read"]
      },
      "expectAllow": true
    },
    {
      "id": "consent_deny_observation",
      "doc": "Active Consent deny on Observation blocks a read that scopes and policy would allow.",
      "principal": "clinician",
      "policy": "narrow-observation",
      "scopes": "patient/*.read",
      "launchPatient": "pat-1",
      "action": "read",
      "resourceType": "Observation",
