        "status": "final",
        "subject": { "reference": "Patient/pat-1" },
        "code": { "text": "toy" }
      },
      "consent": {
        "status": "active",
        "patientId": "pat-1",
        "provisionType": "deny",
        "resourceTypes": ["Observation"],
        "actions": ["read"]
      },
      "expectAllow": false
    },
    {
