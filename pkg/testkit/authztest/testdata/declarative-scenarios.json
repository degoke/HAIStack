      "policy": "base",
      "scopes": "patient/Observation.read",
      "launchPatient": "pat-1",
      "action": "read",
      "resourceType": "Appointment",
      "resourceId": "a1",
      "resource": {
        "resourceType": "Appointment",
        "id": "a1",
        "status": "booked",
        "participant": [{ "actor": { "reference": "Patient/pat-1" }, "status": "accepted" }]
      },
      "expectAllow": false
    },
    {
      "id": "smart_scope_denies_write",
      "doc": "Appointment.read SMART scope cannot write Appointment even when policy allows write.",
      "principal": "clinician",
      "policy": "base",
      "scopes": "patient/Appointment.read",
      "launchPatient": "pat-1",
      "action": "write",
      "resourceType": "Appointment",
      "resourceId": "a1",
      "resource": {
        "resourceType": "Appointment",
